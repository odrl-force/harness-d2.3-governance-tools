    sosa:madeBySensor ex:meter-demo-0042 ;
    sosa:observedProperty ex:electricalEnergyConsumption ;
    sosa:hasFeatureOfInterest ex:household-demo-01 ;
    sosa:phenomenonTime [ a time:Interval ;
        time:hasBeginning [ a time:Instant ; time:inXSDDateTimeStamp "2025-02-01T00:00:00Z"^^xsd:dateTimeStamp ] ;
        time:hasEnd [ a time:Instant ; time:inXSDDateTimeStamp "2025-03-01T00:00:00Z"^^xsd:dateTimeStamp ] ] ;
    sosa:resultTime "2025-03-01T00:00:00Z"^^xsd:dateTimeStamp ;
    sosa:hasResult [ a qudt:QuantityValue ;
        qudt:numericValue "327.04"^^xsd:decimal ;
