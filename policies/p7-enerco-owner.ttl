# D2.3 policy P7: EnerCo's access to its own pod.
# EnerCo may store, change and read the forecasts its service writes.
#
# Requirements: AI1 roles (EnerCo is the service's provider and deployer).

@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix d23:  <http://example.org/d23/> .
@prefix req:  <http://example.org/d23/requirement/> .

# Policy: EnerCo's own access (an Agreement with itself, as P0 is for Anna)
d23:policy-p7-enerco-owner
    a               odrl:Agreement ;
    odrl:uid        d23:policy-p7-enerco-owner ;
    dct:title       "EnerCo may store, change and read its forecasts"@en ;
    dct:requires    req:AI1 ;
    odrl:permission d23:p7-create , d23:p7-modify , d23:p7-read .

# Creating a resource needs create on each container above it
d23:p7-create a odrl:Permission ;
    odrl:action   odrl:create ;
    odrl:target   <http://localhost:3000/enerco/> , <http://localhost:3000/enerco/services/> ,
                  <http://localhost:3000/enerco/services/forecast/> ,
                  <http://localhost:3000/enerco/services/forecast/anna> ;
    odrl:assigner <http://localhost:3000/enerco/profile/card#me> ;
    odrl:assignee <http://localhost:3000/enerco/profile/card#me> .

d23:p7-modify a odrl:Permission ;
    odrl:action   odrl:modify ;
    odrl:target   <http://localhost:3000/enerco/services/> , <http://localhost:3000/enerco/services/forecast/> ,
                  <http://localhost:3000/enerco/services/forecast/anna> ;
    odrl:assigner <http://localhost:3000/enerco/profile/card#me> ;
    odrl:assignee <http://localhost:3000/enerco/profile/card#me> .

d23:p7-read a odrl:Permission ;
    odrl:action   odrl:read ;
    odrl:target   <http://localhost:3000/enerco/services/forecast/> ,
                  <http://localhost:3000/enerco/services/forecast/anna> ;
    odrl:assigner <http://localhost:3000/enerco/profile/card#me> ;
    odrl:assignee <http://localhost:3000/enerco/profile/card#me> .
