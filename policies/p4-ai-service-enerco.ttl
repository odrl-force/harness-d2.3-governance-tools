# D2.3 policy P4: EnerCo's AI forecast service, the offer.
# Any household may use the service for advice on its own energy use, and gets a forecast
# of its own household only (P8 is Anna's agreement). The ban on credit checking is in
# P4b: a prohibition in this policy would make UMA refuse every mixed-purpose request.
#
# Requirements: AI3 intended purpose (AI Act Art. 6.2), AI6 AI disclosure.
#
# An offer for the catalogue only: the run script does not post it to UMA.

@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dpv:  <https://w3id.org/dpv#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix d23:  <http://example.org/d23/> .
@prefix req:  <http://example.org/d23/requirement/> .

# Policy: EnerCo's offer to any household (an Offer: no assignee, nothing agreed yet)
d23:policy-p4-ai-service-enerco
    a               odrl:Offer ;
    odrl:uid        d23:policy-p4-ai-service-enerco ;
    dct:title       "EnerCo's forecast service may be used for advice on a household's own energy use"@en ;
    dct:references  <http://data.europa.eu/eli/reg/2024/1689/oj> ;   # AI Act
    dct:requires    req:AI3 , req:AI6 ;
    odrl:permission d23:p4-permission .

# Permission: anyone may use the service (odrl:read: a call is a GET on its address)
d23:p4-permission
    a               odrl:Permission ;
    odrl:action     odrl:read ;
    odrl:target     <http://localhost:3000/enerco/services/forecast> ;
    odrl:assigner   <http://localhost:3000/enerco/profile/card#me> ;
    odrl:constraint d23:p4-purpose .

# Condition: the stated purpose must be "optimisation for the consumer" (advice)
d23:p4-purpose
    a                 odrl:Constraint ;
    odrl:leftOperand  odrl:purpose ;
    odrl:operator     odrl:eq ;
    odrl:rightOperand dpv:OptimisationForConsumer .
