# D2.3 policy P1: flow 1, data altruism.
# Anna lets the City of Ghent read her meter readings to improve public services
# (urban energy planning) until 1 January 2028.
#
# Requirements: G2 purpose limitation (GDPR Art. 5(1)(b)), D2 purpose lock (DGA Art. 21),
#               G4 storage limitation (GDPR Art. 5(1)(e)), DA2 user-initiated sharing.
#               D1 (recognised altruism organisation) is only partly covered: the City is
#               named as assignee and whether it qualifies is unchecked. 


@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dpv:  <https://w3id.org/dpv#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix d23:  <http://example.org/d23/> .
@prefix req:  <http://example.org/d23/requirement/> .

# Policy: Anna and the City of Ghent (an Agreement with its legal sources and requirements)
d23:policy-p1-altruism-city
    a              odrl:Agreement ;
    odrl:uid       d23:policy-p1-altruism-city ;
    dct:title      "Anna lets the City of Ghent read her meter readings to improve public services"@en ;
    dct:references <http://data.europa.eu/eli/reg/2022/868/oj> ,   # Data Governance Act
                   <http://data.europa.eu/eli/reg/2016/679/oj> ;   # GDPR
    dct:requires   req:G2 , req:G4 , req:D1 , req:D2 , req:DA2 ;
    odrl:permission d23:p1-permission .

# Permission: the City may read the meter readings on the two conditions below
d23:p1-permission
    a               odrl:Permission ;
    odrl:action     odrl:read ;
    odrl:target     <http://localhost:3000/anna/energy/meter-readings> ;
    odrl:assigner   <http://localhost:3000/anna/profile/card#me> ;
    odrl:assignee   <http://localhost:3000/ghent/profile/card#me> ;
    odrl:constraint d23:p1-purpose , d23:p1-until .

# Condition 1: the stated purpose must be "improve public services"
d23:p1-purpose
    a                 odrl:Constraint ;
    odrl:leftOperand  odrl:purpose ;
    odrl:operator     odrl:eq ;
    odrl:rightOperand dpv:ImprovePublicServices .

# Condition 2: only before 1 January 2028 (UTC)
d23:p1-until
    a                 odrl:Constraint ;
    odrl:leftOperand  odrl:dateTime ;
    odrl:operator     odrl:lt ;
    odrl:rightOperand "2028-01-01T00:00:00Z"^^xsd:dateTime .
