{
  "@context": {
    "@version": 1.1,
    "prov": "http://www.w3.org/ns/prov#",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "dpv": "https://w3id.org/dpv#",
    "dct": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "d23": "http://example.org/d23/log#",
    "id": "@id",
    "type": { "@id": "@type", "@type": "@vocab" },
    "PolicyCreated": "d23:PolicyCreated",
    "PolicyRemoved": "d23:PolicyRemoved",
    "AccessRequested": "d23:AccessRequested",
    "DecisionMade": "d23:DecisionMade",
    "DataAccessed": "d23:DataAccessed",
    "time": { "@id": "prov:atTime", "@type": "xsd:dateTime" },
    "source": { "@id": "prov:wasAssociatedWith" },
    "requester": { "@id": "d23:requester", "@type": "@id" },
    "owner": { "@id": "d23:owner", "@type": "@id" },
    "resource": { "@id": "prov:used", "@type": "@id" },
    "action": { "@id": "odrl:action", "@type": "@id" },
    "purposes": { "@id": "dpv:hasPurpose", "@type": "@id", "@container": "@set" },
    "claimTypes": { "@id": "d23:claimType", "@container": "@set" },
    "policy": { "@id": "d23:policyApplied" },
    "hash": { "@id": "d23:hash" },
    "prevHash": { "@id": "d23:previousHash" },
    "decision": { "@id": "d23:decision" },
    "rules": { "@id": "d23:decidingRule", "@type": "@id", "@container": "@set" },
    "correlation": { "@id": "d23:correlation" },
    "seq": { "@id": "d23:sequence", "@type": "xsd:integer" },
    "httpStatus": { "@id": "d23:httpStatus", "@type": "xsd:integer" },
    "note": { "@id": "dct:description" }
  }
}
